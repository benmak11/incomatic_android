<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant-only manifest fragment. AGP merges this into the main
  manifest for debug builds only, so the local-backend network security
  exception never ships in release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
