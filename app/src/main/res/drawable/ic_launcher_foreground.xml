        android:fillColor="#FFFFFF"
        android:pathData="M54,28.5m-5.5,0a5.5,5.5 0,1 1,11 0a5.5,5.5 0,1 1,-11 0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,46h8a4,4 0,0 1,4 4v32a4,4 0,0 1,-4 4h-8a4,4 0,0 1,-4 -4v-32a4,4 0,0 1,4 -4z" />
